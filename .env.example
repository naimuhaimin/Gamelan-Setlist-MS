# Supabase Production Cloud Database Configuration
# ==============================================================================
# Instructions:
# 1. Log in to https://supabase.com and open your Project Dashboard
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste into NEXT_PUBLIC_SUPABASE_URL
# 4. Copy "anon public" API key and paste into NEXT_PUBLIC_SUPABASE_ANON_KEY
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
