# ==============================================================================
# GAMELAN QUEUE & STAGE MANAGEMENT SYSTEM
# Supabase Production Cloud Database Configuration
# ==============================================================================
# Instructions:
# 1. Log in to https://supabase.com and open your Project Dashboard
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste into NEXT_PUBLIC_SUPABASE_URL
# 4. Copy "anon public" API key and paste into NEXT_PUBLIC_SUPABASE_ANON_KEY
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Notifications (optional). Without these two, the Notifications switch is hidden.
# Generate a pair once with:  npx web-push generate-vapid-keys
# Set both in Vercel too (Production and Preview). The private key is a secret.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
